{
  "name": "krix-ultra",
  "version": "8.5.0",
  "description": "KRIX ULTRA v8.5 – Enterprise Edition WhatsApp Automation Tool",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "debug": "node --inspect index.js",
    "prod": "NODE_ENV=production node index.js",
    "cluster": "node cluster.js",
    "test": "node test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf ./auth_info ./logs ./store.json node_modules package-lock.json",
    "clean:logs": "rm -rf ./logs/*.log",
    "clean:session": "rm -rf ./auth_info",
    "backup": "tar -czf backup-$(date +%Y%m%d-%H%M%S).tar.gz ./auth_info ./store.json",
    "restore": "tar -xzf backup.tar.gz",
    "health": "curl http://localhost:5000/health",
    "status": "curl http://localhost:5000/api/status",
    "pair": "curl http://localhost:5000/pair",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop krix-ultra",
    "pm2:restart": "pm2 restart krix-ultra",
    "pm2:logs": "pm2 logs krix-ultra",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "automation",
    "bot",
    "messaging",
    "krix"
  ],
  "author": "KRIX",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "p-limit": "^5.0.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "pm2": "^5.3.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.3"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "undici": "^6.6.2"
  },
  "overrides": {
    "undici": "^6.6.2"
  }
}
